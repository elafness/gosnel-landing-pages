# Cloudflare Pages Redirects - Clean Multi-App Architecture

# TEST: Simple redirect without subdomain complexity
/partner /partner-landing.html 200

# ============================================
# MAIN DOMAIN ROUTING (gosnel.com) - MUST BE FIRST
# ============================================
/ /index.html 200
/pricing /user-pricing.html 200
/how-it-works /user-how-it-works.html 200
/about /user-about.html 200
/faq /user-faq.html 200
/food /user-food.html 200
/blog/* /apps/user-app/blog/:splat 200

# ============================================
# SHARED RESOURCES (SERVE DIRECTLY)  
# ============================================
/shared/* /shared/:splat 200
/assets/* /shared/assets/:splat 200
/pricing /user-pricing.html 200
/how-it-works /user-how-it-works.html 200
/about /user-about.html 200
/faq /user-faq.html 200
/food /user-food.html 200
/blog/* /apps/user-app/blog/:splat 200

# ============================================
# SITEMAPS (SERVE DIRECTLY)
# ============================================
/sitemap.xml /sitemap.xml 200
/robots.txt /robots.txt 200

# ============================================
# BLOCK INTERNAL PATHS
# ============================================
/apps/* / 404
