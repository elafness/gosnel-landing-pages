# Cloudflare Pages Redirects - Clean Multi-App Architecture

# ============================================
# SHARED RESOURCES (SERVE DIRECTLY)
# ============================================
/shared/* /shared/:splat 200
/assets/* /shared/assets/:splat 200

# ============================================
# MAIN DOMAIN ROUTING (gosnel.com - Direct serve)
# ============================================
# Serve user app pages directly without exposing internal paths
/ /apps/user-app/features/landing.html 200
/pricing /apps/user-app/features/pricing.html 200
/how-it-works /apps/user-app/features/how-it-works.html 200
/blog/* /apps/user-app/blog/:splat 200
/about /apps/user-app/about.html 200
/faq /apps/user-app/faq.html 200
/food /apps/user-app/food.html 200

# ============================================
# PARTNER SUBDOMAIN (partner.gosnel.com - Direct serve)
# ============================================
# Serve partner app pages directly
https://partner.gosnel.com/ /apps/partner-app/index.html 200
https://partner.gosnel.com/pricing /apps/partner-app/features/pricing.html 200
https://partner.gosnel.com/how-it-works /apps/partner-app/features/how-it-works.html 200
https://partner.gosnel.com/why-partner /apps/partner-app/features/why-partner.html 200
https://partner.gosnel.com/guidelines /apps/partner-app/features/guidelines.html 200
https://partner.gosnel.com/insights /apps/partner-app/features/insights.html 200

# ============================================
# SITEMAPS (SERVE DIRECTLY)
# ============================================
/sitemap.xml /sitemap.xml 200
/user-sitemap.xml /user-sitemap.xml 200
/vendor-sitemap.xml /vendor-sitemap.xml 200
/drivers-sitemap.xml /drivers-sitemap.xml 200
/promo-sitemap.xml /promo-sitemap.xml 200
/robots.txt /robots.txt 200

