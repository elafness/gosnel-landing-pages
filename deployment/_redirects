/uae/vendor/pricing /vendor/vendor-pricing.html 200
/uae/vendor/how-it-works /vendor/vendor-how-it-works.html 200
/uae/vendor/why-partner /vendor/vendor-why-partner.html 200
/uae/vendor/customer-lead /vendor/vendor-customerLead.html 200
/uae/vendor/guidelines /vendor/vendor-guidelines.html 200
/uae/vendor/insights /vendor/vendor-insights.html 200

# Driver landing page and routes
