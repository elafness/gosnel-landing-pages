# Cloudflare Pages Redirects - Clean Multi-App Architecture

# ============================================
# SHARED RESOURCES (SERVE DIRECTLY)
# ============================================
/shared/* /shared/:splat 200
/assets/* /shared/assets/:splat 200

# ============================================
# CAREERS SUBDOMAIN (careers.gosnel.com)
# ============================================
https://careers.gosnel.com/* /careers/:splat 200
https://careers.gosnel.com/ /careers/ 200

# ============================================
# RESTAURANTS SUBDOMAIN (restaurants.gosnel.com)
# ============================================
https://restaurants.gosnel.com/* https://gosnel.com/partner/ 301
https://restaurants.gosnel.com/ https://gosnel.com/partner/ 301

# ============================================
# MAIN DOMAIN ROUTING (gosnel.com)
# ============================================
# Note: Cloudflare Pages automatically serves .html files without extension
# Only adding specific rewrites where needed

/about-us /about.html 200
/blog/* /apps/user-app/blog/:splat 200
/careers /careers/index.html 200

# ============================================
# SITEMAPS (SERVE DIRECTLY)
# ============================================
/sitemap.xml /sitemap.xml 200
/user-sitemap.xml /user-sitemap.xml 200
/vendor-sitemap.xml /vendor-sitemap.xml 200
/drivers-sitemap.xml /drivers-sitemap.xml 200
/promo-sitemap.xml /promo-sitemap.xml 200
/robots.txt /robots.txt 200

