# Cloudflare Pages Redirects - Multi-App Architecture

# ============================================
# SUBDOMAIN ROUTING (NEW ARCHITECTURE)
# ============================================
# Route subdomains to respective app directories

# Partner subdomain routing
https://partner.gosnel.com/* /apps/partner-app/:splat 200
https://partner.gosnel.com /apps/partner-app/index.html 200

# Future: Driver subdomain routing
# https://drivers.gosnel.com/* /apps/driver-app/:splat 200
# https://drivers.gosnel.com /apps/driver-app/index.html 200

# Main domain routes to user app
https://gosnel.com/* /apps/user-app/:splat 200
https://gosnel.com /apps/user-app/index.html 200

# ============================================
# SHARED RESOURCES ROUTING
# ============================================
# Route shared assets and legal pages
/shared/* /shared/:splat 200
/assets/* /shared/assets/:splat 200

# ============================================
# LEGACY REDIRECTS
# ============================================
# Redirect old paths to new structure

# User paths
/user/* /apps/user-app/features/:splat 301
/blog/* /apps/user-app/blog/:splat 301
/about /apps/user-app/about.html 301
/faq /apps/user-app/faq.html 301

# Vendor to partner redirects
/vendor/* https://partner.gosnel.com/features/:splat 301
/vendor https://partner.gosnel.com/ 301
/partner/* https://partner.gosnel.com/features/:splat 301
/partner https://partner.gosnel.com/ 301

# Legacy subdomain redirects
https://user.gosnel.com/* https://gosnel.com/:splat 301
https://vendor.gosnel.com/* https://partner.gosnel.com/:splat 301

# ============================================
# LEGACY REDIRECTS - uae/user to root
# ============================================
# Redirect old /uae/user paths to root domain for better SEO
/uae/user /  301
/uae/user/ /  301
/uae/user/pricing /pricing  301
/uae/user/how-it-works /how-it-works  301

# ============================================
# SITEMAPS FOR NEW STRUCTURE
# ============================================
/uae/user/sitemap.xml /user-sitemap.xml 200
/uae/vendor/sitemap.xml /vendor-sitemap.xml 200
/uae/driver/sitemap.xml /drivers-sitemap.xml 200
/uae/promo/sitemap.xml /promo-sitemap.xml 200

# Also map the root project domain variants (Cloudflare Pages sometimes serves a single project across multiple custom domains)
gosnel-landing-pages.pages.dev/sitemap.xml /user-sitemap.xml 200
https://gosnel-landing-pages.pages.dev/sitemap.xml /user-sitemap.xml 200

# Extra safety: some edge cases may request /sitemap.xml without the host rule matching.
# Keep these after the host-specific rules.
/vendor/sitemap.xml /vendor-sitemap.xml 200
/user/sitemap.xml /user-sitemap.xml 200
/drivers/sitemap.xml /drivers-sitemap.xml 200
/promo/sitemap.xml /promo-sitemap.xml 200

# ============================================
# STATIC ASSETS (serve directly)
# ============================================
/robots.txt /robots.txt 200

